---
import { site } from "../data/site";
---

<section id="contact" class="section-padding bg-[var(--evergreen-lt)]">
  <div class="container-main">
    <div class="mx-auto max-w-3xl text-center lg:max-w-none lg:text-left">
      <h2
        class="font-heading text-2xl font-semibold text-[var(--ink)] md:text-3xl lg:text-4xl"
      >
        Get a free website review.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-[var(--muted)] md:text-lg">
        Tell me about your business and your current website situation. I'll take
        a look and follow up with thoughts on what a cleaner, more professional
        site could look like for you.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start lg:gap-10">
      <form
        action="https://formspree.io/f/YOUR_FORMSPREE_ENDPOINT"
        method="POST"
        class="space-y-5"
      >
        <!-- Replace with your Formspree endpoint ID after creating a form at formspree.io -->
        <input
          type="hidden"
          name="_subject"
          value="New website review request — Cabriel Lovlie Web Design"
        />

        <div>
          <label for="name" class="form-label">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="form-input"
          />
        </div>

        <div>
          <label for="business" class="form-label">Business name</label>
          <input
            type="text"
            id="business"
            name="business"
            required
            autocomplete="organization"
            class="form-input"
          />
        </div>

        <div>
          <label for="phone" class="form-label">Phone</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            autocomplete="tel"
            class="form-input"
          />
        </div>

        <div>
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="form-input"
          />
        </div>

        <div>
          <label for="website" class="form-label"
            >Current website, if you have one</label
          >
          <input
            type="url"
            id="website"
            name="website"
            autocomplete="url"
            placeholder="https://"
            class="form-input"
          />
        </div>

        <div>
          <label for="business-type" class="form-label"
            >What kind of business is it?</label
          >
          <input
            type="text"
            id="business-type"
            name="business_type"
            class="form-input"
          />
        </div>

        <div>
          <label for="message" class="form-label"
            >What do you need help with?</label
          >
          <textarea
            id="message"
            name="message"
            rows="4"
            class="form-input resize-y"></textarea>
        </div>

        <button type="submit" class="btn-primary btn-primary--evergreen w-full">
          Get My Free Review
        </button>
      </form>

      <aside
        class="rounded-lg border-l-4 border-[var(--evergreen)] bg-[var(--evergreen-lt)] p-6"
      >
        <p class="font-semibold text-[var(--ink)]">Prefer to call or text?</p>
        <p class="mt-4">
          <a
            href={site.phoneHref}
            class="text-lg font-semibold text-[var(--evergreen)] no-underline hover:underline"
          >
            {site.phone}
          </a>
        </p>
        <p class="mt-2">
          <a
            href={site.emailHref}
            class="text-base text-[var(--evergreen)] no-underline hover:underline"
          >
            {site.email}
          </a>
        </p>
      </aside>
    </div>
  </div>
</section>
