---
import { practicalFeatures } from "../data/services";
---

<section id="services" class="section-padding bg-[var(--evergreen-lt)]">
  <div class="container-main">
    <p class="text-sm font-semibold uppercase tracking-wide text-[var(--evergreen)]">
      Visual examples
    </p>
    <h2
      class="font-heading mt-2 max-w-3xl text-2xl font-semibold text-[var(--ink)] md:text-3xl lg:text-4xl"
    >
      Practical features, shown in real examples.
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-[var(--muted)] md:text-lg">
      A good small-business website does more than look clean. It should explain
      the services clearly, show real work, build trust, and give customers an
      easy next step.
    </p>

    <div class="feature-grid mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        practicalFeatures.map(({ title, description, screenshot }) => (
          <article class="feature-card">
            <h3 class="text-base font-semibold text-[var(--ink)] md:text-lg">
              {title}
            </h3>
            <p class="feature-card__description">{description}</p>
            <div
              class:list={[
                "feature-card__media",
                screenshot.variant === "mobile" &&
                  "feature-card__media--mobile",
              ]}
            >
              <img
                src={screenshot.src}
                alt={screenshot.alt}
                width={screenshot.width}
                height={screenshot.height}
                loading="lazy"
                class="services-screenshot"
              />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
